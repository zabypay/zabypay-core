# Copy to `.env` and edit values for your environment.
# NEVER commit a real .env file. All secrets below are placeholders.

# --- Runtime ---
ENVIRONMENT=development          # development | production
RUST_LOG=info

# --- HTTP servers ---
ADDRESS=127.0.0.1
PORT=8080                        # public API

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zabypay

# --- Redis (rate limiting, caching) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Security (REQUIRED — generate strong values for production) ---
# JWT_SECRET:        `openssl rand -hex 32`
# ENCRYPTION_KEY:    32-byte key, base64-encoded: `openssl rand -base64 32`
# CRYPTO_ENCRYPTION_KEY: 32-byte hex key for wallet encryption
JWT_SECRET=replace-with-openssl-rand-hex-32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
CRYPTO_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Rate limiting ---
ENABLE_RATE_LIMITING=false
MAX_REQUESTS_PER_MINUTE=1000

# --- Blockchain RPC endpoints (use your own private nodes in production) ---
# This build accepts ETH, BNB and SOL native currencies only.
ETHEREUM_RPC_URL=
BNB_RPC_URL=
SOLANA_RPC_URL=


# --- Public payment page URL (where customers land to pay) ---
PAYMENT_REQUEST_URL=http://localhost:3000/pay
